        <mxCell id="legend" value="&lt;b style=&quot;font-size:12px;color:#0f172a;&quot;&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#b91c1c&quot;&gt;PK&lt;/font&gt;&lt;/b&gt; primary key &amp;nbsp; &lt;b&gt;&lt;font color=&quot;#15803d&quot;&gt;UQ&lt;/font&gt;&lt;/b&gt; unique&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#b45309&quot;&gt;FK&lt;/font&gt;&lt;/b&gt; foreign key constraint&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#4338ca&quot;&gt;SK&lt;/font&gt;&lt;/b&gt; shared request_id, no FK&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#0369a1&quot;&gt;ASG&lt;/font&gt;&lt;/b&gt; employee_id assignment, no FK&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#7c3aed&quot;&gt;LKP&lt;/font&gt;&lt;/b&gt; form lookup, no FK&lt;br&gt;&lt;font color=&quot;#94a3b8&quot;&gt;NULL&lt;/font&gt; nullable &amp;nbsp; &lt;b&gt;&lt;font color=&quot;#15803d&quot;&gt;UQ*&lt;/font&gt;&lt;/b&gt; composite unique&lt;br&gt;&lt;br&gt;Solid line = FK constraint&lt;br&gt;Dashed line = shared key only" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#334155;fillColor=#ffffff;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="40" y="1330" width="300" height="210" as="geometry"/></mxCell>
        <mxCell id="notes" value="&lt;b style=&quot;font-size:12px;color:#0f172a;&quot;&gt;Model notes&lt;/b&gt;&lt;br&gt;&lt;br&gt;• A requestor and one child row share a 6-character request_id — no ORM foreign key enforces it.&lt;br&gt;• produce stores users.employee_id (a string), not users.id.&lt;br&gt;• soft_copy_requests and trademark_requests are standalone: own request_id, no requestors parent.&lt;br&gt;• notification_reads is the only real FK (cascade on delete)." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#334155;fillColor=#ffffff;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="880" y="1250" width="300" height="230" as="geometry"/></mxCell>
        <mxCell id="status" value="&lt;b style=&quot;font-size:12px;color:#0f172a;&quot;&gt;Status pipelines&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Content&lt;/b&gt; &amp;nbsp; 0 → 1 → 2&lt;br&gt;socmed · photo / video&lt;br&gt;&lt;br&gt;&lt;b&gt;Creative&lt;/b&gt; &amp;nbsp; 0 → 1 → 2 → 4&lt;br&gt;publishing · 3 = denied&lt;br&gt;&lt;br&gt;&lt;b&gt;Soft copy&lt;/b&gt; &amp;nbsp; 0 → 1&lt;br&gt;2 = denied&lt;br&gt;&lt;br&gt;&lt;b&gt;Trademark&lt;/b&gt; &amp;nbsp; 0 → 1&lt;br&gt;2 = denied" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#334155;fillColor=#ffffff;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="300" height="248" as="geometry"/></mxCell>
        <mxCell id="lbl_soft" value="STANDALONE · no requestors parent" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#b45309;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="40" y="538" width="300" height="18" as="geometry"/></mxCell>
